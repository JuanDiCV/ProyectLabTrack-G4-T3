# Copia este archivo como .env (npm run db:env lo hace automáticamente y genera un JWT_SECRET aleatorio)
DATABASE_URL="file:./dev.db"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Secreto para firmar los JWT. NUNCA lo publiques. ensure-env.cjs genera uno aleatorio.
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Seguridad HU-01
LOCK_MINUTES=15

# Caché del catálogo (HU-02 / CP-013)
CATALOG_CACHE_TTL_SECONDS=30

# Contraseñas de los usuarios semilla (matriz de pruebas). Solo para entornos de desarrollo/QA.
SEED_STUDENT_PASSWORD="Estudiante123"
SEED_ADMIN_PASSWORD="Admin123"
